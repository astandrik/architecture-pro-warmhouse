@startuml Context_diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Контекстная диаграмма системы "Тёплый дом" (To-Be — раскрытые сервисы)

Person(user, "Владелец дома", "Управляет домом через UI")

System(apigw, "Smart Home Monolith / BFF", "Монолит (Go)", "Единая точка входа; проксирует в микросервисы")
System(auth_svc, "Auth Service", "Микросервис", "Аутентификация и авторизация")
System(userhouses_svc, "User & Houses Service", "Микросервис", "Пользователи, дома, комнаты, сценарии")
System(devreg_svc, "Device Registry Service", "Микросервис", "Реестр типов/модулей/устройств")
System(device_mgmt_svc, "Device Management & Control", "Микросервис (Node.js)", "Команды устройствам")
System(telemetry_svc, "Telemetry Service", "Микросервис (Node.js)", "Приём и запрос телеметрии")

System_Ext(devices, "Устройства умного дома", "Датчики, реле, свет, ворота, камеры")
System_Ext(temperature_api, "Temperature API", "Внешний источник", "Телеметрия температуры от вендора")
System_Ext(message_broker, "Message Broker", "Kafka/RabbitMQ", "Асинхронные события и команды")

Rel(user, apigw, "Управление и просмотр", "HTTPS")

Rel(apigw, auth_svc, "Проксирует авторизацию", "HTTP")
Rel(apigw, userhouses_svc, "Проксирует запросы домов/сценариев", "HTTP")
Rel(apigw, devreg_svc, "Проксирует запросы реестра", "HTTP")
Rel(apigw, device_mgmt_svc, "Проксирует команды", "HTTP")
Rel(apigw, telemetry_svc, "Проксирует запросы телеметрии", "HTTP")

Rel(temperature_api, message_broker, "Телеметрия →", "HTTP/Async")
Rel(telemetry_svc, userhouses_svc, "События для сценариев", "HTTP/Async")
Rel(devices, message_broker, "Телеметрия →, Команды ←", "MQTT/IoT")
Rel(telemetry_svc, message_broker, "Читает/публикует события", "Async")
Rel(device_mgmt_svc, message_broker, "Публикует команды", "Async")

SHOW_LEGEND()
@enduml